# syntax=docker/dockerfile:1.7
FROM composer:2 AS vendor
WORKDIR /app
COPY composer.json composer.lock ./
RUN --mount=type=cache,target=/tmp/composer-cache \
    composer install --no-dev --prefer-dist --no-interaction --no-progress --ignore-platform-req=ext-gd

FROM php:8.2-apache
RUN apt-get update && apt-get install -y --no-install-recommends libicu-dev libpng-dev libzip-dev \
    && docker-php-ext-install gd intl mysqli zip \
    && rm -rf /var/lib/apt/lists/*
COPY --from=vendor /app/vendor /var/www/html/vendor
COPY . /var/www/html
RUN a2enmod rewrite && chown -R www-data:www-data /var/www/html/config
